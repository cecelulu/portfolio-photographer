---
import Icon from './Icon.astro';
import { formatPrice } from '../data/site';

interface Props {
  car: {
    slug: string;
    brand: string;
    model: string;
    name: string;
    power: number;
    engine: string;
    priceFrom: number;
    youngDrivers: boolean;
    category: string;
    cutout: string;
    cutoutW: number;
    cutoutH: number;
  };
}
const { car } = Astro.props;
const title = car.category === 'gt' ? car.model : car.brand;
---

<article class="car-card">
  <div class="car-card__media">
    <img src={car.cutout} alt={car.name} width={car.cutoutW} height={car.cutoutH} loading="lazy" decoding="async" />
    {car.youngDrivers && <span class="car-card__badge">Dès 16 ans</span>}
  </div>
  <div class="car-card__body">
    <div>
      <p class="car-card__brand">{car.brand} · {car.power} ch</p>
      <h3 class="car-card__title">
        <a href={`/stages/${car.slug}/`}>{title}</a>
      </h3>
      <p class="car-card__price">dès {formatPrice(car.priceFrom)}</p>
    </div>
    <span class="car-card__go" aria-hidden="true"><Icon name="arrow" size={18} /></span>
  </div>
</article>

<style>
  .car-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 10px;
    background: var(--surface);
    border-radius: var(--radius);
    border: 1px solid #ececee;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }
  .car-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .car-card__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    padding: 18px 16px;
    border-radius: var(--radius-sm);
    background: var(--studio);
    overflow: hidden;
  }
  .car-card__media img {
    width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 14px 12px rgba(0, 0, 0, 0.18));
    transition: transform 0.5s var(--ease-out);
  }
  .car-card:hover .car-card__media img {
    transform: scale(1.04);
  }
  .car-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink);
  }
  .car-card__body {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 12px;
    padding: 16px 8px 8px;
  }
  .car-card__brand {
    margin: 0;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .car-card__title {
    margin: 2px 0 4px;
    font-size: 1.15rem;
    font-weight: 500;
  }
  .car-card__title a {
    color: inherit;
    text-decoration: none;
  }
  .car-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .car-card__price {
    margin: 0;
    font-weight: 600;
    color: var(--ink);
  }
  .car-card__go {
    flex: none;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--magenta);
    color: #fff;
    transform: rotate(-45deg);
    transition: transform 0.3s var(--ease-out);
  }
  .car-card:hover .car-card__go {
    transform: rotate(0);
  }
</style>
