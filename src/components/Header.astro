---
import Icon from './Icon.astro';
import { site } from '../data/site';

const nav = [
  { href: '/stages/', label: 'Nos stages' },
  { href: '/circuits/', label: 'Circuits' },
  { href: '/offrir/', label: 'Offrir' },
  { href: '/entreprises/', label: 'Entreprises' },
  { href: '/le-stage/', label: 'Le déroulement' },
  { href: '/faq/', label: 'FAQ' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="header" data-header>
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label="Sprint Racing – accueil">
      <img src="/images/logo/sprint-racing.png" alt="Sprint Racing" width="205" height="47" />
    </a>

    <nav class="nav" aria-label="Navigation principale" id="menu" data-menu>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav__mobile-extra">
        <a class="btn btn--block" href="/commande/">Réserver mon stage</a>
        <a class="nav__phone" href={site.phoneFrHref}><Icon name="phone" size={18} /> {site.phoneFr}</a>
        <a class="nav__phone" href={site.phoneBeHref}><Icon name="phone" size={18} /> {site.phoneBe} (Belgique)</a>
      </div>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={site.phoneFrHref}><Icon name="phone" size={16} /> {site.phoneFr}</a>
      <a class="header__call" href={site.phoneFrHref} aria-label={`Appeler le ${site.phoneFr}`}>
        <Icon name="phone" size={20} />
      </a>
      <a class="btn btn--sm header__cta" href="/commande/">Réserver mon stage</a>
      <button class="header__burger" type="button" aria-controls="menu" aria-expanded="false" data-burger>
        <span class="sr-only">Ouvrir le menu</span>
        <Icon name="menu" size={26} class="icon-open" />
        <Icon name="close" size={26} class="icon-close" />
      </button>
    </div>
  </div>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const header = document.querySelector<HTMLElement>('[data-header]');

  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    if (!open && header) {
      document.documentElement.style.setProperty('--menu-top', `${header.getBoundingClientRect().bottom}px`);
    }
    menu?.classList.toggle('is-open', !open);
    document.body.classList.toggle('menu-open', !open);
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && burger?.getAttribute('aria-expanded') === 'true') burger.click();
  });

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(243, 243, 243, 0.92);
    backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .header.is-scrolled {
    border-color: var(--line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--header-h);
  }
  .header__logo img {
    width: 190px;
    height: auto;
  }

  .nav {
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    display: block;
    white-space: nowrap;
    padding: 8px 14px;
    border-radius: 8px;
    color: #8c8c94;
    font-weight: 500;
    font-size: 0.92rem;
    text-decoration: none;
    position: relative;
  }
  .nav ul a:hover {
    color: var(--ink);
  }
  .nav ul a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }
  .nav__mobile-extra {
    display: none;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .header__phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-right: 6px;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .header__phone:hover {
    color: var(--magenta-600);
  }
  .header__phone :global(svg) {
    color: var(--ink);
  }
  @media (max-width: 1480px) {
    .header__phone {
      display: none;
    }
  }
  .header__call {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    color: var(--teal-700);
    background: var(--teal-50);
  }
  .header__burger {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 10px;
    background: var(--bg-soft);
    color: var(--ink);
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }
  .header__burger :global(.icon-close) {
    display: none;
  }
  .header__burger[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }
  .header__burger[aria-expanded='true'] :global(.icon-open) {
    display: none;
  }

  @media (max-width: 1100px) {
    .nav ul a {
      padding: 8px 8px;
      font-size: 0.9rem;
    }
  }

  @media (max-width: 980px) {
    .header__burger,
    .header__call {
      display: inline-flex;
    }
    .header__actions {
      margin-left: auto;
    }
    .header__cta {
      display: none;
    }
    .header {
      backdrop-filter: none;
      background: var(--bg);
    }
    .nav {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      top: var(--menu-top, 108px);
      background: var(--bg);
      padding: 16px var(--gutter) 32px;
      overflow-y: auto;
      transform: translateX(100%);
      visibility: hidden;
      transition: transform 0.25s ease, visibility 0.25s;
    }
    .nav.is-open {
      transform: none;
      visibility: visible;
    }
    .nav ul {
      flex-direction: column;
      gap: 0;
    }
    .nav ul a {
      padding: 16px 4px;
      font-size: 1.15rem;
      border-bottom: 1px solid var(--line);
      border-radius: 0;
    }
    .nav ul a[aria-current='page']::after {
      display: none;
    }
    .nav__mobile-extra {
      display: grid;
      gap: 14px;
      margin-top: 24px;
    }
    .nav__phone {
      display: inline-flex !important;
      align-items: center;
      gap: 10px;
      border: 0 !important;
      padding: 4px 0 !important;
      color: var(--teal-700) !important;
    }
    .header__logo img {
      width: 160px;
    }
  }

  :global(body.menu-open) {
    overflow: hidden;
  }
</style>
