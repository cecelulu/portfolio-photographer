---
// 1er bloc de l'accueil : grande photo sombre, titre, texte, bouton rond,
// petite carte vidéo et grand texte métallique, placés comme sur la maquette.
import Lucide from '../Lucide.astro';
import { site } from '../../data/site';
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__media" aria-hidden="true">
    <picture>
      <source media="(max-width: 900px)" srcset="/images/maquette/accueil-900.webp 900w, /images/maquette/accueil-1672.webp 1672w, /images/maquette/accueil-2800.webp 2800w" sizes="150vw" />
      <img
        class="hero__img"
        src="/images/maquette/accueil-1672.webp"
        srcset="/images/maquette/accueil-1672.webp 1672w, /images/maquette/accueil-2800.webp 2800w"
        sizes="100vw"
        alt=""
        width="1672"
        height="941"
        fetchpriority="high"
        decoding="async"
        data-hero-img
      />
    </picture>
    <span class="hero__shade"></span>
  </div>

  <div class="hero__content">
    <h1 class="hero__title" id="hero-title" data-hero-title>
      <span class="line"><span>Pilotez</span></span>
      <span class="line"><span>votre passion</span></span>
    </h1>
    <p class="hero__lead" data-hero-fade>
      Stages de pilotage en GT et en monoplace sur 25 circuits en France et en Belgique, depuis 2002.
    </p>
    <div class="hero__ctas" data-hero-fade>
      <a class="btn hero__btn" href="#prestations">
        Découvrir nos stages <Lucide name="ArrowRight" size={17} stroke={2} />
      </a>
      <a class="btn btn--light hero__btn" href="/offrir/">Offrir un stage</a>
    </div>
  </div>

  <a class="hero__video" href={site.social.youtube} target="_blank" rel="noopener" data-hero-fade data-float="8">
    <img src="/images/maquette/video.webp" alt="" width="564" height="752" loading="eager" />
    <span class="hero__play" aria-hidden="true"><Lucide name="Play" size={18} stroke={2} /></span>
    <span class="hero__video-label">Notre école<br />en vidéo</span>
    <span class="sr-only">(sur YouTube, nouvel onglet)</span>
  </a>

  <p class="hero__giant" aria-hidden="true" data-hero-giant>
    <span>sprint</span>
    <span>racing</span>
  </p>

</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* Proche du rapport de la maquette (853 × 463). */
    height: clamp(640px, 54.3vw, 900px);
    background: #12060c;
    color: #fff;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 50%;
    transform-origin: 62% 55%;
    will-change: transform;
  }
  .hero__content,
  .hero__video {
    z-index: 2;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(12, 4, 5, 0.55) 0%, rgba(12, 4, 5, 0) 38%),
      linear-gradient(0deg, rgba(10, 4, 5, 0.35) 0%, rgba(10, 4, 5, 0) 25%);
  }

  .hero__content {
    position: absolute;
    left: 4.3%;
    top: 24.5%;
    width: min(38%, 560px);
  }
  .hero__title {
    margin: 0 0 0.42em;
    font-size: clamp(2.7rem, 5.6vw, 5.6rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: #fff;
  }
  .hero__title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
    white-space: nowrap;
  }
  .hero__title .line > span {
    display: inline-block;
  }
  .hero__lead {
    max-width: 44ch;
    margin: 0;
    font-size: clamp(0.92rem, 1.1vw, 1.08rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.86);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(22px, 2.4vw, 34px);
  }
  .hero__btn {
    min-height: 52px;
    padding-inline: 26px;
  }
  .hero__ctas .btn--light {
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(6px);
  }

  .hero__video {
    position: absolute;
    right: 4.1%;
    top: 16.2%;
    width: clamp(120px, 11.4vw, 176px);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 14px;
    color: #fff;
    text-decoration: none;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.4);
  }
  .hero__video img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    transition: transform 0.6s var(--ease-out);
  }
  .hero__video::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.72) 100%);
  }
  .hero__video:hover img {
    transform: scale(1.12);
  }
  .hero__play {
    position: absolute;
    left: 50%;
    top: 40%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #fff;
    color: var(--accent-bright);
    translate: -50% -50%;
    box-shadow: 0 0 0 5px rgba(205, 57, 138, 0.85);
    transition: transform 0.35s var(--ease-out);
  }
  .hero__play :global(svg) {
    fill: currentColor;
    margin-left: 2px;
  }
  .hero__video:hover .hero__play {
    transform: scale(1.1);
  }
  .hero__video-label {
    position: absolute;
    left: 12%;
    right: 8%;
    bottom: 9%;
    z-index: 1;
    font-size: clamp(0.82rem, 1.05vw, 1.05rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .hero__giant {
    position: absolute;
    right: 4%;
    bottom: calc(3.6% + 46px); /* au-dessus de la bande de garanties */
    margin: 0;
    display: grid;
    justify-items: end;
    font-size: clamp(4.4rem, 10.4vw, 12rem);
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.065em;
    pointer-events: none;
    user-select: none;
  }
  .hero__giant span {
    display: block;
    padding: 0 0.04em 0.06em 0;
    background: linear-gradient(180deg, #ffffff 0%, #e7e7e7 30%, #a9a9ab 62%, rgba(120, 120, 124, 0.55) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 10px 24px rgba(0, 0, 0, 0.35));
  }

  /* ---- Tablette et mobile ---- */
  @media (max-width: 900px) {
    .hero {
      height: auto;
      display: flex;
      flex-direction: column;
    }
    /* Sur mobile, la photo suit le titre, en pleine largeur et peu zoomée :
       la voiture reste entière et nette. */
    .hero {
      min-height: 0;
      padding-bottom: clamp(96px, 16vw, 140px);
      background: #030203;
    }
    .hero__media {
      position: relative;
      inset: auto;
      order: 1;
      height: min(84vw, 560px);
      margin-top: 8px;
      /* La photo se fond dans le fond noir en haut et en bas : pas de démarcation. */
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 20%, #000 62%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 20%, #000 62%, transparent 100%);
    }
    .hero__img {
      object-position: 84% 50%;
    }
    .hero__shade {
      background:
        linear-gradient(180deg, #030203 0%, rgba(3, 2, 3, 0) 22%, rgba(3, 2, 3, 0) 78%, #030203 100%);
    }
    .hero__content {
      position: relative;
      left: auto;
      top: auto;
      width: auto;
      padding: calc(var(--header-h) + var(--header-gap) + 44px) var(--gutter) 0;
    }
    .hero__title {
      font-size: clamp(2.7rem, 11vw, 4.4rem);
    }
    .hero__video {
      top: calc(var(--header-h) + var(--header-gap) + 44px);
      right: var(--gutter);
      width: 112px;
      border-radius: 12px;
    }
    .hero__giant {
      right: var(--gutter);
      bottom: 14px;
      font-size: clamp(3.4rem, 17vw, 7rem);
    }
  }
  @media (max-width: 560px) {
    .hero__video {
      display: none;
    }
    .hero__giant {
      font-size: 19vw;
    }
  }
</style>
