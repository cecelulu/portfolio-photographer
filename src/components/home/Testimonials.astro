---
// 6e bloc : avis clients dans une grande carte sombre, un avis à la fois, flèches de part et d'autre.
import Lucide from '../Lucide.astro';
import { reviews, reviewsSummary } from '../../data/content';
---

<section class="testi" aria-labelledby="testi-title">
  <div class="container container--wide">
    <div class="testi__card" data-testi data-reveal>
      <p class="testi__badge">
        <span class="testi__badge-icon"><Lucide name="Smile" size={18} stroke={2} /></span>
        <span>
          <strong>Stagiaires<br />conquis</strong>
        </span>
      </p>
      <p class="testi__score">
        <strong>{reviewsSummary.score}</strong>
        {reviewsSummary.votes}
      </p>

      <h2 class="testi__title" id="testi-title">Ce que disent nos stagiaires</h2>

      <div class="testi__viewport" aria-live="off" data-live>
        {
          reviews.map((r, i) => (
            <figure class="testi__slide" data-slide hidden={i !== 0}>
              <blockquote>
                <p>« {r.text} »</p>
              </blockquote>
              <span class="testi__stars" aria-hidden="true">
                {Array.from({ length: 5 }, () => (
                  <Lucide name="Star" size={17} stroke={1.5} />
                ))}
              </span>
              <figcaption>
                — {r.name} · {r.car}, {r.place}
              </figcaption>
            </figure>
          ))
        }
      </div>

      <button class="testi__nav testi__nav--prev" type="button" data-prev>
        <span class="sr-only">Avis précédent</span>
        <Lucide name="ArrowLeft" size={16} stroke={2} />
      </button>
      <button class="testi__nav testi__nav--next" type="button" data-next>
        <span class="sr-only">Avis suivant</span>
        <Lucide name="ArrowRight" size={16} stroke={2} />
      </button>

      <div class="testi__dots" aria-hidden="true">
        {reviews.map((_, i) => <span class:list={{ 'is-active': i === 0 }}></span>)}
      </div>
    </div>
  </div>
</section>

<style>
  .testi {
    padding-bottom: clamp(30px, 3vw, 46px);
  }
  .testi__card {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 3vw, 44px) clamp(64px, 9vw, 150px) clamp(28px, 2.6vw, 40px);
    border-radius: 16px;
    background:
      radial-gradient(ellipse 50% 90% at 50% 120%, rgba(160, 20, 18, 0.18), transparent 70%),
      var(--night);
    color: #fff;
    text-align: center;
  }
  .testi__badge {
    position: absolute;
    left: clamp(18px, 2.4vw, 38px);
    top: clamp(18px, 2.2vw, 34px);
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    text-align: left;
    font-size: 0.78rem;
    line-height: 1.15;
  }
  .testi__badge strong {
    font-weight: 500;
  }
  .testi__badge-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #fff;
    color: var(--accent-bright);
    box-shadow: 0 0 0 5px rgba(200, 35, 30, 0.75);
  }
  .testi__score {
    position: absolute;
    right: clamp(18px, 2.4vw, 38px);
    top: clamp(18px, 2.2vw, 34px);
    margin: 0;
    display: grid;
    justify-items: end;
    font-size: 0.74rem;
    color: rgba(255, 255, 255, 0.6);
  }
  .testi__score strong {
    font-size: 1.15rem;
    font-weight: 500;
    color: #fff;
  }
  .testi__title {
    margin: 0 0 clamp(10px, 1vw, 14px);
    font-size: clamp(0.9rem, 1vw, 1rem);
    font-weight: 400;
    letter-spacing: 0;
    color: rgba(255, 255, 255, 0.82);
  }
  .testi__viewport {
    display: grid;
  }
  .testi__slide {
    grid-area: 1 / 1;
    margin: 0;
  }
  .testi__slide blockquote {
    margin: 0;
  }
  .testi__slide p {
    max-width: 52ch;
    margin: 0 auto;
    font-size: clamp(1.1rem, 1.6vw, 1.5rem);
    line-height: 1.32;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .testi__stars {
    display: inline-flex;
    gap: 6px;
    margin: clamp(10px, 1vw, 14px) 0 6px;
    color: #e3302b;
  }
  .testi__stars :global(svg) {
    fill: currentColor;
  }
  .testi__slide figcaption {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.62);
  }
  .testi__nav {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-top: -17px;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 50%;
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition: background 0.3s var(--ease-out), color 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }
  .testi__nav:hover {
    background: #fff;
    color: var(--ink);
    transform: scale(1.08);
  }
  .testi__nav--prev {
    left: clamp(14px, 2.4vw, 38px);
  }
  .testi__nav--next {
    right: clamp(14px, 2.4vw, 38px);
  }
  .testi__dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 16px;
  }
  .testi__dots span {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.25);
    transition: width 0.4s var(--ease-out), background 0.4s var(--ease-out);
  }
  .testi__dots span.is-active {
    width: 22px;
    background: var(--accent-bright);
  }

  @media (max-width: 760px) {
    .testi__card {
      padding: 92px 22px 76px;
    }
    .testi__nav {
      top: auto;
      bottom: 22px;
      margin-top: 0;
    }
    .testi__nav--prev {
      left: 22px;
    }
    .testi__nav--next {
      right: 22px;
    }
    .testi__dots {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 36px;
      margin: 0;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  document.querySelectorAll<HTMLElement>('[data-testi]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLElement>('.testi__dots span')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer: number | undefined;

    const show = (next: number, dir: 1 | -1) => {
      next = (next + slides.length) % slides.length;
      if (next === index) return;
      const from = slides[index];
      const to = slides[next];
      dots[index]?.classList.remove('is-active');
      dots[next]?.classList.add('is-active');
      index = next;
      if (reduce) {
        from.hidden = true;
        to.hidden = false;
        return;
      }
      gsap.killTweensOf([from, to]);
      to.hidden = false;
      gsap.fromTo(from, { autoAlpha: 1, x: 0 }, { autoAlpha: 0, x: -40 * dir, duration: 0.45, ease: 'power2.in', onComplete: () => { from.hidden = true; } });
      gsap.fromTo(to, { autoAlpha: 0, x: 40 * dir }, { autoAlpha: 1, x: 0, duration: 0.7, delay: 0.25, ease: 'power3.out' });
    };

    const restart = () => {
      window.clearInterval(timer);
      if (!reduce) timer = window.setInterval(() => show(index + 1, 1), 7000);
    };

    // Les changements automatiques ne sont pas annoncés ; ceux demandés au clavier ou à la souris, si.
    const live = root.querySelector<HTMLElement>('[data-live]');
    const manual = (step: 1 | -1) => {
      live?.setAttribute('aria-live', 'polite');
      show(index + step, step);
      restart();
    };
    root.querySelector('[data-prev]')?.addEventListener('click', () => manual(-1));
    root.querySelector('[data-next]')?.addEventListener('click', () => manual(1));
    root.addEventListener('mouseenter', () => window.clearInterval(timer));
    root.addEventListener('mouseleave', restart);
    root.addEventListener('focusin', () => window.clearInterval(timer));
    restart();
  });
</script>
