---
// 5e bloc : l'équipe. Portraits de la maquette (illustrations), métiers et chiffres réels de Sprint Racing.
import Badge from './Badge.astro';
import Lucide from '../Lucide.astro';

const team = [
  { title: 'Nos mécaniciens', role: 'Formés chez les constructeurs', href: '/le-stage/', image: '/images/maquette/portrait-1.webp' },
  { title: 'Nos moniteurs', role: 'Plus de 250, diplômés BPJEPS', href: '/le-stage/', image: '/images/maquette/portrait-2.webp' },
  { title: 'Relation client', role: 'Du lundi au samedi', href: '/contact/', image: '/images/maquette/portrait-3.webp' },
];
---

<section class="team" aria-labelledby="team-title">
  <div class="container container--wide">
    <header class="team__head" data-reveal>
      <Badge label="Notre équipe" />
      <h2 id="team-title">Les passionnés derrière<br />chacun de vos tours</h2>
    </header>

    <ul class="team__list" data-stagger>
      {
        team.map((m) => (
          <li class="member">
            <span class="member__photo">
              <img src={m.image} alt="" width="300" height="300" loading="lazy" decoding="async" />
            </span>
            <span class="member__card">
              <span class="member__text">
                <a class="member__name" href={m.href}>{m.title}</a>
                <span class="member__role">{m.role}</span>
              </span>
              <Lucide name="ArrowRight" size={16} stroke={1.8} class="member__arrow" />
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .team {
    padding-bottom: clamp(36px, 3.2vw, 52px);
  }
  .team__head {
    text-align: center;
    margin-bottom: clamp(18px, 1.6vw, 26px);
  }
  .team__head h2 {
    margin: 0;
    font-size: clamp(1.6rem, 2.6vw, 2.35rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }
  .team__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 384px));
    justify-content: center;
    gap: clamp(16px, 2.4vw, 40px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .member {
    position: relative;
    display: flex;
    align-items: center;
  }
  .member__photo {
    position: relative;
    z-index: 1;
    flex: none;
    width: clamp(118px, 12.1vw, 176px);
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    background: #e6e6e6;
    box-shadow: 0 14px 34px rgba(20, 10, 10, 0.14);
  }
  .member__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease-out);
  }
  .member:hover .member__photo img {
    transform: scale(1.08);
  }
  .member__card {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    min-height: clamp(84px, 8.8vw, 128px);
    margin-left: clamp(-56px, -3.6vw, -40px);
    padding: 0 clamp(16px, 1.6vw, 24px) 0 clamp(52px, 5vw, 74px);
    border-radius: 22px;
    background: #f2f2f2;
    transition: background 0.35s var(--ease-out);
  }
  .member:hover .member__card {
    background: var(--accent-50);
  }
  .member__text {
    display: grid;
    gap: 2px;
  }
  .member__name {
    white-space: nowrap;
    font-size: clamp(0.98rem, 1.2vw, 1.15rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }
  .member__name::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .member__role {
    font-size: 0.76rem;
    line-height: 1.35;
    color: var(--muted);
  }
  .member :global(.member__arrow) {
    flex: none;
    color: var(--ink);
    transition: transform 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }
  .member:hover :global(.member__arrow) {
    transform: translateX(4px);
    color: var(--accent);
  }

  @media (max-width: 1000px) {
    .team__list {
      grid-template-columns: minmax(0, 440px);
      gap: 18px;
    }
  }
</style>
