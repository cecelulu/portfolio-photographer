---
// 4e bloc : deux grandes cartes photo, texte posé sur l'image.
import Lucide from '../Lucide.astro';

const cards = [
  {
    icon: 'Gift',
    tag: 'Coffrets et chèques cadeaux',
    title: 'Offrez un stage<br/>de pilotage',
    text: 'Bon cadeau envoyé par e-mail en 5 minutes, ou coffret livré par courrier. Le bénéficiaire choisit sa date.',
    href: '/offrir/',
    link: 'Voir les cadeaux',
    image: '/images/maquette/visuel-1.webp',
  },
  {
    icon: 'Users',
    tag: 'Groupes et entreprises',
    title: 'Votre événement<br/>sur circuit',
    text: 'Séminaire, team-building ou incentive, de 8 à 300 personnes, en Île-de-France ou en région.',
    href: '/entreprises/',
    link: 'Demander un devis',
    image: '/images/maquette/visuel-2.webp',
  },
] as const;
---

<section class="feat" aria-label="Offrir et entreprises">
  <div class="container container--wide feat__grid" data-stagger>
    {
      cards.map((c) => (
        <article class="fcard">
          <img class="fcard__img" src={c.image} alt="" width="955" height="365" loading="lazy" decoding="async" />
          <div class="fcard__body">
            <span class="fcard__icons" aria-hidden="true">
              <Lucide name={c.icon} size={15} stroke={1.8} />
              <i></i>
              <Lucide name="ArrowUpRight" size={15} stroke={1.8} />
            </span>
            <span class="fcard__tag">{c.tag}</span>
            <h2 class="fcard__title">
              <a href={c.href} set:html={c.title} />
            </h2>
            <p class="fcard__text">{c.text}</p>
          </div>
          <span class="fcard__more" aria-hidden="true">
            {c.link} <Lucide name="ArrowRight" size={15} stroke={2} />
          </span>
        </article>
      ))
    }
  </div>
</section>

<style>
  .feat {
    padding-bottom: clamp(34px, 2.6vw, 44px);
  }
  .feat__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(10px, 1.15vw, 18px);
  }
  .fcard {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    min-height: clamp(240px, 18.2vw, 290px);
    border-radius: 12px;
    background: #0b0b0c;
    color: #fff;
  }
  .fcard__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }
  .fcard::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.08) 55%, rgba(0, 0, 0, 0) 100%);
  }
  .fcard:hover .fcard__img {
    transform: scale(1.06);
  }
  .fcard__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(18px, 2.3vw, 34px);
    padding-bottom: clamp(18px, 1.8vw, 26px);
  }
  .fcard__icons {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: auto;
    padding: 6px 12px;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 999px;
    color: #fff;
    background: rgba(0, 0, 0, 0.15);
    backdrop-filter: blur(4px);
  }
  .fcard__icons i {
    width: 1px;
    height: 12px;
    background: rgba(255, 255, 255, 0.45);
  }
  .fcard__tag {
    margin: 18px 0 8px;
    padding: 3px 12px;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 500;
  }
  .fcard__title {
    margin: 0 0 6px;
    font-size: clamp(1.35rem, 1.95vw, 1.85rem);
    font-weight: 450;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .fcard__title a {
    color: inherit;
    text-decoration: none;
  }
  .fcard__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .fcard__text {
    max-width: 34ch;
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.78);
  }
  .fcard__more {
    position: absolute;
    right: clamp(18px, 2.3vw, 34px);
    bottom: clamp(18px, 1.8vw, 26px);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .fcard__more :global(svg) {
    transition: transform 0.3s var(--ease-out);
  }
  .fcard:hover .fcard__more :global(svg) {
    transform: translateX(5px);
  }

  @media (max-width: 860px) {
    .feat__grid {
      grid-template-columns: 1fr;
    }
    .fcard {
      min-height: 300px;
    }
    .fcard__body {
      padding-bottom: 58px;
    }
    .fcard__more {
      left: clamp(18px, 2.3vw, 34px);
      right: auto;
    }
    .fcard::before {
      background: linear-gradient(0deg, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.1) 70%);
    }
  }
</style>
