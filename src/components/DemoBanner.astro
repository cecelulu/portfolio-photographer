---
import { site } from '../data/site';
---

<div class="demo-banner" role="note">
  <p class="container">
    <strong>Maquette non officielle</strong>
    <span class="demo-banner__sep" aria-hidden="true">·</span>
    <span>Aucune réservation possible ici.</span>
    <a href={site.officialUrl} rel="noopener">Site officiel de Sprint Racing →</a>
  </p>
</div>

<style>
  .demo-banner {
    background: #fff4c2;
    color: #4a3b00;
    border-bottom: 1px solid #efd97a;
    font-size: 0.8rem;
    line-height: 1.35;
  }
  .demo-banner p {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2px 8px;
    margin: 0 auto;
    padding-block: 6px;
    text-align: center;
  }
  .demo-banner a {
    color: #4a3b00;
    font-weight: 700;
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .demo-banner__sep {
      display: none;
    }
  }
</style>
