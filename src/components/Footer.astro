---
import Icon from './Icon.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
const columns = [
  {
    title: 'Stages',
    links: [
      { href: '/stages/', label: 'Toutes les voitures' },
      { href: '/stages/multi-gt/', label: 'Multi GT : duo, trio' },
      { href: '/stages/#monoplace', label: 'Monoplace' },
      { href: '/stages/drift/', label: 'Drift et glisse' },
      { href: '/stages/jeunes/', label: 'Stage jeunes dès 16 ans' },
      { href: '/stages/coaching/', label: 'Coaching' },
    ],
  },
  {
    title: 'Sprint Racing',
    links: [
      { href: '/circuits/', label: 'Nos circuits' },
      { href: '/offrir/', label: 'Offrir un stage' },
      { href: '/entreprises/', label: 'Groupes et entreprises' },
      { href: '/le-stage/', label: 'Le déroulement' },
      { href: '/faq/', label: 'Questions fréquentes' },
    ],
  },
];
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <img src="/images/logo/sprint-racing.png" alt="Sprint Racing" width="205" height="47" loading="lazy" />
      <p>Stages de pilotage en GT et en monoplace sur 25 circuits en France et en Belgique, depuis 2002.</p>
      <div class="footer__social">
        <a href={site.social.instagram} aria-label="Instagram" rel="noopener" target="_blank"><Icon name="instagram" size={18} /></a>
        <a href={site.social.facebook} aria-label="Facebook" rel="noopener" target="_blank"><Icon name="facebook" size={18} /></a>
        <a href={site.social.youtube} aria-label="YouTube" rel="noopener" target="_blank"><Icon name="youtube" size={18} /></a>
      </div>
    </div>

    {
      columns.map((col) => (
        <div>
          <h3>{col.title}</h3>
          <ul>
            {col.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div>
      <h3>Contact</h3>
      <ul class="footer__contact">
        <li><a href={site.phoneFrHref}>{site.phoneFr}</a> <span>France</span></li>
        <li><a href={site.phoneBeHref}>{site.phoneBe}</a> <span>Belgique</span></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><span>{site.hours}</span></li>
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© {year} {site.name} · {site.legal.company}</p>
    <nav aria-label="Liens légaux">
      <a href="/mentions-legales/">Mentions légales et crédits photo</a>
      <a href="/contact/">Contact</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.92rem;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 40px;
    padding-block: 64px 48px;
  }
  .footer__brand img {
    width: 170px;
    margin-bottom: 16px;
  }
  .footer__brand p {
    max-width: 34ch;
  }
  .footer h3 {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 14px;
  }
  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }
  .footer a {
    color: var(--muted);
    text-decoration: none;
  }
  .footer a:hover {
    color: var(--ink);
  }
  .footer__contact a {
    color: var(--ink);
    font-weight: 500;
  }
  .footer__contact span {
    color: #9a9aa2;
  }
  .footer__social {
    display: flex;
    gap: 8px;
  }
  .footer__social a {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    border: 1px solid var(--line);
  }
  .footer__social a:hover {
    background: var(--ink);
    color: #fff;
    border-color: var(--ink);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-block: 20px 28px;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
  }
  .footer__bottom p {
    margin: 0;
  }
  .footer__bottom nav {
    display: flex;
    gap: 20px;
  }
  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
