---
// Pied de page : présentation, navigation, coordonnées, puis la ligne finale de la maquette
// (© à gauche, liens utiles au centre, réseaux sociaux à droite).
import Lucide from './Lucide.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
const columns = [
  {
    title: 'Nos stages',
    links: [
      { href: '/stages/', label: 'Toutes les voitures' },
      { href: '/stages/multi-gt/', label: 'Multi GT : duo, trio' },
      { href: '/stages/#monoplace', label: 'Monoplace' },
      { href: '/stages/drift/', label: 'Drift et glisse' },
      { href: '/stages/jeunes/', label: 'Stage jeunes dès 16 ans' },
      { href: '/stages/coaching/', label: 'Coaching' },
    ],
  },
  {
    title: 'Sprint Racing',
    links: [
      { href: '/circuits/', label: 'Nos circuits' },
      { href: '/offrir/', label: 'Offrir un stage' },
      { href: '/entreprises/', label: 'Groupes et entreprises' },
      { href: '/le-stage/', label: 'Le déroulement' },
      { href: '/faq/', label: 'Questions fréquentes' },
      { href: '/commande/', label: 'Réserver en ligne' },
    ],
  },
];
---

<footer class="footer">
  <div class="container container--wide">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" aria-label="Sprint Racing – accueil">
          <img src="/images/logo/sprint-racing.png" alt="Sprint Racing" width="410" height="94" loading="lazy" />
        </a>
        <p>
          L’école leader du stage de pilotage en GT et en monoplace : 25 circuits en France et en Belgique, plus d’un
          million de stagiaires accueillis depuis 2002.
        </p>
        <a class="btn btn--sm" href="/commande/">Réserver mon stage</a>
      </div>

      {
        columns.map((col) => (
          <nav aria-label={col.title}>
            <h2 class="footer__title">{col.title}</h2>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div>
        <h2 class="footer__title">Contact</h2>
        <ul class="footer__contact">
          <li>
            <Lucide name="Phone" size={15} />
            <span><a href={site.phoneFrHref}>{site.phoneFr}</a> France</span>
          </li>
          <li>
            <Lucide name="Phone" size={15} />
            <span><a href={site.phoneBeHref}>{site.phoneBe}</a> Belgique</span>
          </li>
          <li>
            <Lucide name="Mail" size={15} />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <Lucide name="Clock" size={15} />
            <span>{site.hours}</span>
          </li>
          <li>
            <Lucide name="MapPin" size={15} />
            <span>{site.address.street}, {site.address.zip} {site.address.city}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {year} {site.name} · {site.group}. Tous droits réservés.</p>
      <nav class="footer__legal" aria-label="Liens utiles">
        <a href="/mentions-legales/">Mentions légales</a>
        <a href="/mentions-legales/#credits">Crédits photo</a>
        <a href="/contact/">Contact</a>
      </nav>
      <div class="footer__social">
        <a href={site.social.instagram} rel="noopener" target="_blank" aria-label="Instagram (nouvel onglet)">
          <Lucide name="Instagram" size={16} />
        </a>
        <a href={site.social.facebook} rel="noopener" target="_blank" aria-label="Facebook (nouvel onglet)">
          <Lucide name="Facebook" size={16} />
        </a>
        <a href={site.social.youtube} rel="noopener" target="_blank" aria-label="YouTube (nouvel onglet)">
          <Lucide name="Youtube" size={16} />
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(8px, 1vw, 16px);
    background: var(--bg);
    color: var(--muted);
    font-size: 0.88rem;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.4fr;
    gap: clamp(28px, 4vw, 56px);
    padding: clamp(36px, 4vw, 56px) clamp(4px, 1.4vw, 20px) clamp(28px, 3vw, 44px);
    border-top: 1px solid var(--line);
  }
  .footer__brand img {
    width: 150px;
    height: auto;
    margin-bottom: 16px;
  }
  .footer__brand p {
    max-width: 38ch;
    margin-bottom: 18px;
  }
  .footer__title {
    margin: 0 0 14px;
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink);
  }
  .footer ul {
    display: grid;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s var(--ease-out);
  }
  .footer a:hover {
    color: var(--accent);
  }
  .footer .btn {
    color: #fff;
  }
  .footer__contact li {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 10px;
    align-items: start;
  }
  .footer__contact :global(svg) {
    margin-top: 3px;
    color: var(--accent-bright);
  }
  .footer__contact a {
    color: var(--ink);
    font-weight: 500;
  }

  .footer__bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 18px clamp(4px, 1.4vw, 20px) 26px;
    border-top: 1px solid var(--line);
    font-size: 0.76rem;
  }
  .footer__bottom p {
    margin: 0;
  }
  .footer__legal {
    display: flex;
    gap: 18px;
  }
  .footer__legal a {
    color: var(--ink);
  }
  .footer__social {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
  }
  .footer__social a {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: var(--ink);
    transition: background 0.25s var(--ease-out), color 0.25s var(--ease-out), transform 0.25s var(--ease-out);
  }
  .footer__social a:hover {
    background: var(--accent);
    color: #fff;
    transform: translateY(-2px);
  }

  @media (max-width: 960px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .footer__bottom {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
    .footer__social {
      justify-content: center;
    }
  }
</style>
