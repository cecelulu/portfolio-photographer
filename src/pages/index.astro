---
import Base from '../layouts/Base.astro';
import CarCard from '../components/CarCard.astro';
import Icon from '../components/Icon.astro';
import { formatPrice } from '../data/site';
import { reviews, reviewsSummary } from '../data/content';
import cars from '../data/cars.json';
import circuitsData from '../data/circuits.json';

const gt = cars.filter((c) => c.category === 'gt');
const mono = cars.filter((c) => c.category === 'monoplace');
// Carrousel « collection » : toutes les voitures, les plus puissantes d'abord, puis les monoplaces.
const collection = [...gt].sort((a, b) => b.power - a.power).concat(mono);
const mainStage = cars.find((c) => c.slug === 'porsche-992-gt3')!;
const closing = cars.find((c) => c.slug === 'aston-martin-vantage')!;

const regions = Object.entries(circuitsData.regions).map(([key, label]) => ({
  key,
  label,
  circuits: circuitsData.circuits.filter((c) => c.regionKey === key),
}));

const services = [
  { title: 'Multi GT', text: 'Pilotez 2, 3, 4 ou 5 voitures d’exception le même jour.', href: '/stages/multi-gt/', price: 194.9 },
  { title: 'Monoplace', text: 'Formule Renault ou Formule 4, seul à bord, comme un pilote.', href: '/stages/#monoplace', price: 249 },
  { title: 'Drift et glisse', text: 'Apprenez la dérive sur piste arrosée à La Ferté-Gaucher.', href: '/stages/drift/', price: 169 },
  { title: 'Stage jeunes', text: 'Dès 16 ans en conduite accompagnée, avec un moniteur diplômé.', href: '/stages/jeunes/', price: 99.9 },
];

const reasons = [
  'Un moniteur diplômé d’État à vos côtés',
  '150 GT et 30 monoplaces entretenues dans nos ateliers',
  '25 circuits homologués FFSA en France et en Belgique',
  'Aucune caution sur les stages GT, paiement en 3× sans frais',
];
---

<Base
  title="Sprint Racing – Stage de pilotage sur circuit en Ferrari, Lamborghini, Porsche"
  description="Stages de pilotage sur circuit en Ferrari, Lamborghini, Porsche, McLaren et monoplace sur 25 circuits en France et en Belgique. Dès 16 ans. Idée cadeau inoubliable."
>
  <!-- HERO -->
  <section class="hero hero--studio">
    <div class="container">
      <h1 class="hero__title">Pilotez les plus belles<br /><em>sportives</em> sur circuit</h1>

      <div class="hero__stage">
        <picture class="hero__car-wrap">
          <source media="(max-width: 700px)" srcset="/images/hd/temerario-1000.webp" />
          <img
            class="hero__car"
            src="/images/hd/temerario-2000.webp"
            alt="Lamborghini Temerario gris-bleu mat"
            width="2000"
            height="1261"
            fetchpriority="high"
          />
        </picture>

        <form class="hero__panel" action="/commande/" method="get" aria-label="Trouver votre stage" data-hero-panel>
          <div class="seg" role="radiogroup" aria-label="Type de stage">
            <label><input type="radio" name="_kind" value="gt" checked /><span>Stage GT</span></label>
            <label><input type="radio" name="_kind" value="mono" /><span>Monoplace</span></label>
            <label><input type="radio" name="_kind" value="cadeau" /><span>Cadeau</span></label>
          </div>
          <div class="hero__fields" data-fields>
            <label class="hero__field">
              <span class="sr-only">Voiture</span>
              <select name="voiture" data-voiture>
                <optgroup label="GT" data-kind="gt">
                  {gt.map((c) => <option value={c.slug}>{c.name}</option>)}
                </optgroup>
                <optgroup label="Monoplace" data-kind="mono" disabled hidden>
                  {mono.map((c) => <option value={c.slug}>{c.name}</option>)}
                </optgroup>
              </select>
            </label>
            <label class="hero__field">
              <span class="sr-only">Circuit</span>
              <select name="circuit">
                <option value="">Tous les circuits</option>
                {
                  regions.map((r) => (
                    <optgroup label={r.label}>
                      {r.circuits.map((c) => (
                        <option value={c.slug}>{c.name}</option>
                      ))}
                    </optgroup>
                  ))
                }
              </select>
            </label>
          </div>
          <p class="hero__gift" data-gift hidden>Coffrets dès 144 € et chèques cadeaux dès 50 €, valables un an sur tous nos circuits.</p>
          <input type="hidden" name="produit" value="coffret" disabled data-gift-input />
          <input type="hidden" name="cadeau" value="1" disabled data-gift-input />
          <button class="btn btn--block" type="submit" data-submit>Voir les prix</button>
        </form>
      </div>

      <div class="hero__foot">
        <div class="hero__intro">
          <p>Ferrari, Lamborghini, Porsche, McLaren ou monoplace : 17 voitures d’exception sur 25 circuits en France et en Belgique. Débutant ou confirmé, dès 16 ans.</p>
          <a class="btn" href="/commande/">Réserver mon stage</a>
        </div>
        <a class="hero__scroll" href="#stages">(Défiler)<span aria-hidden="true"></span></a>
      </div>
    </div>
  </section>

  <!-- NOS STAGES -->
  <section class="section" id="stages">
    <div class="container">
      <h2 class="center">Nos stages</h2>
      <div class="services">
        <a class="services__main" href="/stages/#gt">
          <div class="services__media">
            <img src={mainStage.cutout} alt={mainStage.name} width={mainStage.cutoutW} height={mainStage.cutoutH} loading="lazy" />
          </div>
          <div class="services__main-body">
            <div>
              <h3>Stage GT</h3>
              <p>15 supercars de 292 à 920 ch, un moniteur assis à vos côtés.</p>
            </div>
            <span class="services__price">dès {formatPrice(99.9)}</span>
          </div>
        </a>
        {
          services.map((s) => (
            <a class="services__item" href={s.href}>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <span class="services__more">
                dès {formatPrice(s.price)} <Icon name="arrow" size={16} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- COLLECTION -->
  <section class="section section--tight">
    <div class="container">
      <div class="collection-head">
        <h2>Découvrez notre<br />collection</h2>
        <div>
          <p>Des voitures d’exception choisies pour le circuit, toutes entretenues dans nos propres ateliers par des mécaniciens formés chez les constructeurs.</p>
          <div class="collection-nav">
            <a class="underline-link" href="/stages/">Voir les {collection.length} voitures</a>
            <span class="collection-nav__arrows">
              <button type="button" class="round-btn" data-carousel-prev aria-label="Voitures précédentes"><Icon name="arrow" size={18} /></button>
              <button type="button" class="round-btn" data-carousel-next aria-label="Voitures suivantes"><Icon name="arrow" size={18} /></button>
            </span>
          </div>
        </div>
      </div>
      <div class="carousel" data-carousel tabindex="0" aria-label="Nos voitures, faites défiler">
        {collection.map((car) => <div class="carousel__item"><CarCard car={car} /></div>)}
      </div>
    </div>
  </section>

  <!-- POURQUOI -->
  <section class="section">
    <div class="container why">
      <div class="why__text">
        <p class="eyebrow">Pourquoi Sprint Racing ?</p>
        <h2>L’école leader du stage de pilotage, depuis plus de 20 ans.</h2>
        <ul class="why__list">
          {reasons.map((r) => <li><Icon name="check" size={14} />{r}</li>)}
        </ul>
        <a class="btn" href="/le-stage/">Découvrir le déroulement</a>
      </div>
      <div class="why__media">
        <img src="/images/categories/stage-de-pilotage-multivolant.webp" alt="Porsche 911 GT3 et Ford Mustang Shelby sur circuit" width="800" height="440" loading="lazy" />
        <div class="why__stat">
          <strong>+1 million</strong>
          <span>de stagiaires accueillis</span>
        </div>
      </div>
    </div>
  </section>

  <!-- AVIS -->
  <section class="testimonials">
    <img class="testimonials__bg" src="/images/voitures/multigt2.webp" alt="" width="1920" height="500" loading="lazy" />
    <div class="container">
      <div class="testimonials__head">
        <p class="eyebrow eyebrow--dark">Avis clients</p>
        <h2>{reviewsSummary.score} sur {reviewsSummary.votes},<br />ils en parlent mieux que nous</h2>
      </div>
      <div class="testimonials__grid">
        {
          reviews.slice(0, 3).map((r) => (
            <figure class="testimonial">
              <div class="testimonial__stars" aria-label="5 étoiles">
                {Array.from({ length: 5 }).map(() => (
                  <Icon name="star" size={14} />
                ))}
              </div>
              <blockquote>{r.text}</blockquote>
              <figcaption>
                <strong>{r.name}</strong>
                <span>{r.place}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- APPEL FINAL -->
  <section class="section">
    <div class="container closing">
      <div class="closing__text">
        <p class="eyebrow">Prêt à prendre le volant ?</p>
        <h2>Réservez votre stage ou offrez-le, en quelques clics.</h2>
        <div class="closing__ctas">
          <a class="btn" href="/commande/">Réserver mon stage</a>
          <a class="btn btn--dark" href="/offrir/">Offrir un stage</a>
        </div>
      </div>
      <img class="closing__car" src={closing.cutout} alt={closing.name} width={closing.cutoutW} height={closing.cutoutH} loading="lazy" />
    </div>
  </section>
</Base>

<script>
  // Panneau de recherche du hero : Stage GT / Monoplace / Cadeau.
  const form = document.querySelector<HTMLFormElement>('[data-hero-panel]');
  if (form) {
    const select = form.querySelector<HTMLSelectElement>('[data-voiture]')!;
    const groups = Array.from(select.querySelectorAll<HTMLOptGroupElement>('optgroup'));
    const fields = form.querySelector<HTMLElement>('[data-fields]')!;
    const gift = form.querySelector<HTMLElement>('[data-gift]')!;
    const giftInputs = form.querySelectorAll<HTMLInputElement>('[data-gift-input]');
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name !== '_kind') return;
      const isGift = t.value === 'cadeau';
      fields.hidden = isGift;
      gift.hidden = !isGift;
      fields.querySelectorAll('select').forEach((s) => (s.disabled = isGift));
      giftInputs.forEach((i) => (i.disabled = !isGift));
      submit.textContent = isGift ? 'Choisir un cadeau' : 'Voir les prix';
      if (!isGift) {
        groups.forEach((g) => {
          const on = g.dataset.kind === t.value;
          g.hidden = !on;
          g.disabled = !on;
        });
        select.value = groups.find((g) => !g.disabled)!.querySelector('option')!.value;
      }
    });
    // Le choix « _kind » sert seulement à l’affichage : on ne l’envoie pas.
    form.addEventListener('submit', () => form.querySelectorAll<HTMLInputElement>('[name="_kind"]').forEach((r) => (r.disabled = true)));
  }

  // Carrousel de la collection : flèches précédent / suivant.
  const track = document.querySelector<HTMLElement>('[data-carousel]');
  const prev = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-carousel-next]');
  if (track && prev && next) {
    const step = () => (track.querySelector<HTMLElement>('.carousel__item')?.offsetWidth ?? 300) + 16;
    const update = () => {
      prev.disabled = track.scrollLeft < 8;
      next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 8;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step() * 2, behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step() * 2, behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>

<style>
  .center {
    text-align: center;
  }
  .section--tight {
    padding-top: 0;
  }

  /* ---------- Hero ---------- */
  .hero {
    padding-block: clamp(28px, 4vw, 48px) clamp(40px, 5vw, 64px);
  }
  .hero__title em {
    font-style: normal;
    color: var(--magenta);
  }
  .hero__title {
    margin: 0;
    font-size: clamp(2.3rem, 4.6vw, 3.6rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }
  .hero__stage {
    position: relative;
  }
  .hero__car-wrap {
    display: block;
    will-change: transform;
  }
  .hero__car {
    display: block;
    width: min(82%, 980px);
    height: auto;
    margin-inline: auto 12%;
    filter: drop-shadow(0 30px 26px rgba(0, 0, 0, 0.16));
  }
  .hero__panel {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 300px;
    display: grid;
    gap: 10px;
    padding: 14px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    box-shadow: 0 20px 40px rgba(17, 17, 19, 0.1);
  }
  .seg {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: rgba(17, 17, 19, 0.06);
  }
  .seg label {
    cursor: pointer;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .seg span {
    display: block;
    padding: 7px 4px;
    border-radius: 999px;
    text-align: center;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
  }
  .seg input:checked + span {
    background: #fff;
    color: var(--ink);
    box-shadow: 0 1px 3px rgba(17, 17, 19, 0.12);
  }
  .seg input:focus-visible + span {
    outline: 2px solid var(--ink);
  }
  .hero__fields {
    display: grid;
    gap: 8px;
  }
  .hero__field select {
    width: 100%;
    min-height: 44px;
    padding: 8px 14px;
    border: 1px solid rgba(17, 17, 19, 0.08);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.85);
    font: inherit;
    font-size: 0.9rem;
    color: var(--ink);
  }
  .hero__gift {
    margin: 4px 4px 2px;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .hero__foot {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-top: 8px;
  }
  .hero__intro {
    max-width: 380px;
  }
  .hero__intro p {
    color: var(--text);
    margin-bottom: 18px;
  }
  .hero__scroll {
    display: grid;
    justify-items: center;
    gap: 8px;
    font-size: 0.78rem;
    color: var(--muted);
    text-decoration: none;
  }
  .hero__scroll span {
    width: 1px;
    height: 40px;
    background: var(--ink);
    opacity: 0.5;
  }

  /* ---------- Nos stages ---------- */
  .services {
    display: grid;
    grid-template-columns: 1.15fr 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 16px;
    margin-top: 36px;
  }
  .services__main {
    grid-row: span 2;
    display: flex;
    flex-direction: column;
    padding: 10px;
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.3s var(--ease-out);
  }
  .services__media {
    flex: 1;
    display: grid;
    place-items: center;
    min-height: 260px;
    padding: 24px;
    border-radius: var(--radius-sm);
    background: var(--studio);
  }
  .services__media img {
    width: 100%;
    filter: drop-shadow(0 18px 14px rgba(0, 0, 0, 0.18));
  }
  .services__main-body {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    padding: 18px 10px 10px;
  }
  .services__main-body h3 {
    margin-bottom: 4px;
  }
  .services__main-body p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .services__price {
    flex: none;
    font-weight: 600;
  }
  .services__item {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 28px 24px;
    border-radius: var(--radius);
    background: var(--surface);
    text-align: center;
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }
  .services__item h3 {
    margin-bottom: 6px;
  }
  .services__item p {
    margin: 0 0 14px;
    font-size: 0.9rem;
    color: var(--muted);
    max-width: 26ch;
  }
  .services__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .services__main:hover,
  .services__item:hover {
    box-shadow: var(--shadow-lg);
  }
  .services__item:hover {
    transform: translateY(-3px);
  }

  /* ---------- Collection ---------- */
  .collection-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 32px;
    margin-bottom: 32px;
  }
  .collection-head h2 {
    margin: 0;
  }
  .collection-head > div {
    max-width: 380px;
  }
  .collection-head p {
    font-size: 0.92rem;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .collection-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .collection-nav__arrows {
    display: flex;
    gap: 8px;
  }
  .round-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid #d6d6da;
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s var(--ease-out), color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }
  .round-btn:hover {
    background: var(--magenta);
    border-color: var(--magenta);
    color: #fff;
  }
  .round-btn[data-carousel-prev] :global(svg) {
    transform: rotate(180deg);
  }
  .round-btn:disabled {
    opacity: 0.35;
    pointer-events: none;
  }
  .carousel {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 3 * 16px) / 4);
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 8px 2px 24px;
    margin: -8px -2px 0;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .carousel::-webkit-scrollbar {
    display: none;
  }
  .carousel:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
    border-radius: var(--radius);
  }
  .carousel__item {
    scroll-snap-align: start;
    display: flex;
  }
  .carousel__item > :global(*) {
    flex: 1;
  }
  .underline-link {
    font-weight: 500;
    font-size: 0.92rem;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* ---------- Pourquoi ---------- */
  .why {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .why__text h2 {
    max-width: 16ch;
  }
  .why__list {
    list-style: none;
    padding: 0;
    margin: 24px 0 32px;
    display: grid;
    gap: 12px;
  }
  .why__list li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .why__list :global(svg) {
    flex: none;
    width: 22px;
    height: 22px;
    padding: 4px;
    border-radius: 50%;
    background: var(--magenta-50);
    color: var(--magenta);
  }
  .why__media {
    position: relative;
  }
  .why__media img {
    width: 100%;
    aspect-ratio: 4 / 3.2;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .why__stat {
    position: absolute;
    left: 18px;
    bottom: 18px;
    display: grid;
    padding: 14px 18px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    line-height: 1.25;
  }
  .why__stat strong {
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .why__stat span {
    font-size: 0.82rem;
    color: var(--muted);
  }

  /* ---------- Avis ---------- */
  .testimonials {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(64px, 8vw, 96px);
    background: #0b0b0d;
    color: #c9c9cf;
  }
  .testimonials__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.14;
    filter: grayscale(1);
  }
  .testimonials__head {
    text-align: center;
    margin-bottom: 40px;
  }
  .testimonials__head h2 {
    color: #fff;
  }
  .eyebrow--dark {
    color: #a3a3ab;
  }
  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .testimonial {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .testimonial__stars {
    display: flex;
    gap: 3px;
    color: var(--magenta);
  }
  .testimonial__stars :global(svg) {
    fill: var(--magenta);
  }
  .testimonial blockquote {
    margin: 0;
    font-size: 0.95rem;
    color: #e4e4e8;
  }
  .testimonial figcaption {
    margin-top: auto;
    display: grid;
    font-size: 0.85rem;
  }
  .testimonial figcaption strong {
    color: #fff;
    font-weight: 500;
  }
  .testimonial figcaption span {
    color: #8e8e96;
