---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import { faq } from '../data/content';
import { site } from '../data/site';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.flatMap((g) =>
    g.items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } }))
  ),
};
---

<Base
  title="Questions fréquentes sur les stages de pilotage"
  description="Âge minimum, permis, caution, nombre de tours, bons cadeaux, déroulement : toutes les réponses à vos questions sur les stages de pilotage Sprint Racing."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <PageHero
    eyebrow="FAQ"
    title="Questions fréquentes"
    lead="Tout ce qu’il faut savoir avant de prendre le volant."
    image="/images/voitures/A110S.webp"
    crumbs={[{ href: '/faq/', label: 'FAQ' }]}
  />

  <section class="section">
    <div class="container faq-layout">
      <nav class="faq-nav" aria-label="Rubriques">
        {faq.map((g, i) => <a href={`#rubrique-${i + 1}`}>{g.group}</a>)}
      </nav>
      <div>
        {
          faq.map((g, i) => (
            <div class="faq-group" id={`rubrique-${i + 1}`}>
              <h2>{g.group}</h2>
              <FaqList items={g.items} />
            </div>
          ))
        }
        <div class="faq-more card">
          <h3>Vous n’avez pas trouvé votre réponse ?</h3>
          <p>
            Notre service client vous répond {site.hours.toLowerCase()} au <a href={site.phoneFrHref}>{site.phoneFr}</a> ou par e-mail à
            <a href={`mailto:${site.email}`}>{site.email}</a>.
          </p>
          <a class="btn btn--sm" href="/contact/">Nous écrire</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .faq-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 48px;
    align-items: start;
  }
  .faq-nav {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: grid;
    gap: 6px;
  }
  .faq-nav a {
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  .faq-nav a:hover {
    background: var(--bg-soft);
    color: var(--magenta-600);
  }
  .faq-group + .faq-group {
    margin-top: 48px;
  }
  .faq-group h2 {
    font-size: 2rem;
  }
  .faq-more {
    margin-top: 48px;
    padding: 28px;
    background: var(--magenta-50);
    border-color: transparent;
  }
  .faq-more h3 {
    text-transform: uppercase;
  }
  @media (max-width: 860px) {
    .faq-layout {
      grid-template-columns: 1fr;
    }
    .faq-nav {
      position: static;
      display: flex;
      flex-wrap: wrap;
    }
    .faq-nav a {
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 8px 14px;
      font-size: 0.92rem;
    }
  }
</style>
