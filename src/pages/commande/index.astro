---
// Tunnel de commande de DÉMONSTRATION : aucun paiement n'est demandé ni encaissé,
// aucun numéro de carte n'est saisi. Les prix (hors promotion) viennent du site actuel.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import cars from '../../data/cars.json';
import circuitsData from '../../data/circuits.json';
import pricing from '../../data/pricing.json';
import { giftBoxes } from '../../data/content';
import { site, formatPrice, TEL_PATTERN } from '../../data/site';

const carInfo = Object.fromEntries(
  cars.map((c) => [c.slug, { name: c.name, power: c.power, image: c.imageSmall, category: c.category }])
);
const circuitInfo = Object.fromEntries(
  circuitsData.circuits.map((c) => [c.slug, { name: c.name, city: c.city, dept: c.department, region: c.region }])
);
const regionOrder = Object.values(circuitsData.regions);
const boxes = giftBoxes.map((g) => ({ name: g.name, price: g.price, text: g.text }));
const payload = { pricing, carInfo, circuitInfo, regionOrder, boxes, courier: 12.9 };
---

<Base
  title="Réserver et payer votre stage (démonstration)"
  description="Tunnel de réservation de démonstration : choisissez votre voiture, votre circuit et votre formule."
  noindex
>
  <section class="checkout-top">
    <div class="container">
      <nav aria-label="Fil d’Ariane">
        <ol class="breadcrumb breadcrumb--dark">
          <li><a href="/">Accueil</a></li>
          <li aria-current="page">Réservation en ligne</li>
        </ol>
      </nav>
      <h1>Réservez votre stage</h1>
      <ol class="stepper" aria-label="Étapes de la commande">
        <li class="is-current" data-stepper="1"><span>1</span> Votre stage</li>
        <li data-stepper="2"><span>2</span> Vos informations</li>
        <li data-stepper="3"><span>3</span> Paiement</li>
      </ol>
    </div>
  </section>

  <div class="demo-note container" role="note">
    <Icon name="shield" size={20} />
    <p><strong>Parcours de démonstration.</strong> Les prix sont ceux du site actuel (hors promotion), mais aucun paiement n’est demandé ni encaissé.</p>
  </div>

  <section class="section section--soft checkout-section">
    <div class="container checkout">
      <form id="checkout" class="card form-card" novalidate>
        <!-- ÉTAPE 1 -->
        <div class="step" data-step="1">
          <h2 class="form-section__title"><span class="form-section__num">1</span> Votre stage</h2>

          <div class="tabs" role="radiogroup" aria-label="Que souhaitez-vous acheter ?">
            <label class="tab"><input type="radio" name="produit" value="stage" checked /> <span>Stage de pilotage</span></label>
            <label class="tab"><input type="radio" name="produit" value="coffret" /> <span>Coffret cadeau</span></label>
            <label class="tab"><input type="radio" name="produit" value="cheque" /> <span>Chèque cadeau</span></label>
          </div>

          <div data-for="stage">
            <div class="form-grid">
              <label class="field">
                <span>Voiture <span class="req">*</span></span>
                <select name="voiture" required>
                  <optgroup label="GT">
                    {cars.filter((c) => c.category === 'gt').map((c) => <option value={c.slug}>{c.name} – {c.power} ch</option>)}
                  </optgroup>
                  <optgroup label="Monoplace">
                    {cars.filter((c) => c.category === 'monoplace').map((c) => <option value={c.slug}>{c.name} – {c.power} ch</option>)}
                  </optgroup>
                </select>
              </label>
              <label class="field">
                <span>Circuit <span class="req">*</span></span>
                <select name="circuit" required></select>
              </label>
            </div>
            <fieldset class="field formulas-field">
              <legend>Formule <span class="req">*</span></legend>
              <div class="choice-grid formulas" data-formulas></div>
            </fieldset>
            <label class="field qty">
              <span>Nombre de stages</span>
              <input type="number" name="quantite" min="1" max="10" value="1" inputmode="numeric" />
            </label>
          </div>

          <div data-for="coffret" hidden>
            <p class="hint-line">Le bénéficiaire choisit lui-même sa voiture, son circuit et sa date parmi les formules du coffret. Valable un an.</p>
            <div class="choice-grid">
              {
                boxes.map((b, i) => (
                  <label class="choice choice--card">
                    <input type="radio" name="coffret" value={b.name} checked={i === 0} />
                    <strong>{b.name}</strong>
                    <small>{formatPrice(b.price)}</small>
                  </label>
                ))
              }
            </div>
          </div>

          <div data-for="cheque" hidden>
            <label class="field amount">
              <span>Montant du chèque cadeau <span class="req">*</span></span>
              <div class="amount__row">
                {[50, 100, 150, 200, 300].map((a, i) => (
                  <label class="chip"><input type="radio" name="montant_preset" value={a} checked={i === 1} /> <span>{a} €</span></label>
                ))}
              </div>
              <input type="number" name="montant" min="50" max="2000" step="10" value="100" inputmode="numeric" required />
              <span class="hint">De 50 à 2 000 €, utilisable sur tous les stages.</span>
            </label>
          </div>

          <div class="gift-toggle">
            <label class="checkbox">
              <input type="checkbox" name="cadeau" />
              <span><strong>C’est un cadeau</strong> : bon cadeau personnalisé au nom du bénéficiaire</span>
            </label>
            <div class="form-grid" data-gift hidden>
              <label class="field">
                <span>Prénom et nom du bénéficiaire <span class="req">*</span></span>
                <input type="text" name="beneficiaire" required autocomplete="off" />
              </label>
              <fieldset class="field full">
                <legend>Envoi</legend>
                <div class="choice-grid">
                  <label class="choice"><input type="radio" name="envoi" value="email" checked /><span>Par e-mail <small>PDF en 5 minutes – gratuit</small></span></label>
                  <label class="choice"><input type="radio" name="envoi" value="courrier" /><span>Coffret par courrier <small>+12,90 € – expédié le jour même avant 12h</small></span></label>
                </div>
              </fieldset>
            </div>
          </div>

          <div class="step-actions">
            <button type="button" class="btn" data-next>Continuer <Icon name="arrow" size={18} /></button>
          </div>
        </div>

        <!-- ÉTAPE 2 -->
        <div class="step" data-step="2" hidden>
          <h2 class="form-section__title"><span class="form-section__num">2</span> Vos informations</h2>
          <div class="form-grid">
            <label class="field"><span>Prénom <span class="req">*</span></span><input type="text" name="prenom" required autocomplete="given-name" /></label>
            <label class="field"><span>Nom <span class="req">*</span></span><input type="text" name="nom" required autocomplete="family-name" /></label>
            <label class="field"><span>E-mail <span class="req">*</span></span><input type="email" name="email" required autocomplete="email" /></label>
            <label class="field"><span>Téléphone <span class="req">*</span></span><input type="tel" name="telephone" required autocomplete="tel" pattern={TEL_PATTERN} /></label>
          </div>
          <div class="form-grid address" data-address hidden>
            <p class="full hint-line">Adresse de livraison du coffret</p>
            <label class="field full"><span>Adresse <span class="req">*</span></span><input type="text" name="adresse" required autocomplete="street-address" /></label>
            <label class="field"><span>Code postal <span class="req">*</span></span><input type="text" name="cp" required autocomplete="postal-code" inputmode="numeric" /></label>
            <label class="field"><span>Ville <span class="req">*</span></span><input type="text" name="ville" required autocomplete="address-level2" /></label>
          </div>
          <div class="step-actions">
            <button type="button" class="btn btn--ghost" data-prev>Retour</button>
            <button type="button" class="btn" data-next>Continuer vers le paiement <Icon name="arrow" size={18} /></button>
          </div>
        </div>

        <!-- ÉTAPE 3 -->
        <div class="step" data-step="3" hidden>
          <h2 class="form-section__title"><span class="form-section__num">3</span> Paiement</h2>
          <fieldset class="field">
            <legend class="sr-only">Moyen de paiement</legend>
            <div class="pay-methods">
              <label class="choice pay"><input type="radio" name="paiement" value="Carte bancaire" checked /><span><strong>Carte bancaire</strong><small>CB, Visa, Mastercard</small></span><span class="pay__logos">CB · VISA · MC</span></label>
              <label class="choice pay"><input type="radio" name="paiement" value="3× sans frais" /><span><strong>Paiement en 3× sans frais</strong><small data-three>3 × —</small></span><span class="pay__logos">3×</span></label>
              <label class="choice pay"><input type="radio" name="paiement" value="PayPal" /><span><strong>PayPal</strong><small>Compte PayPal ou carte</small></span><span class="pay__logos">PayPal</span></label>
            </div>
          </fieldset>
          <div class="pay-demo">
            <Icon name="shield" size={22} />
            <p><strong>Démonstration :</strong> sur le vrai site, vous seriez redirigé vers la page sécurisée de la banque ou de PayPal pour saisir vos informations de paiement. Ici, aucun paiement n’est demandé ni encaissé.</p>
          </div>
          <label class="checkbox cgv">
            <input type="checkbox" name="cgv" required />
            <span>J’accepte les conditions générales de vente et je comprends qu’il s’agit d’une démonstration. <span class="req">*</span></span>
          </label>
          <div class="step-actions">
            <button type="button" class="btn btn--ghost" data-prev>Retour</button>
            <button type="submit" class="btn" data-pay>Payer <span data-pay-amount></span></button>
          </div>
        </div>
      </form>

      <aside class="summary-wrap">
        <div class="summary card" aria-live="polite">
          <div class="summary__media"><img data-sum-img src="" alt="" width="800" height="208" /></div>
          <div class="summary__body">
            <p class="summary__title">Votre commande</p>
            <ul class="summary__lines" data-sum-lines></ul>
            <div class="summary__total">
              <span>Total</span>
              <strong data-sum-total>—</strong>
            </div>
            <p class="summary__three" data-sum-three></p>
            <ul class="summary__perks">
              <li><Icon name="check" size={16} /> Date modifiable</li>
              <li><Icon name="check" size={16} /> Aucune caution (stages GT)</li>
              <li><Icon name="check" size={16} /> Valable un an</li>
            </ul>
          </div>
        </div>
        <p class="help">Une question ? <a href={site.phoneFrHref}>{site.phoneFr}</a> ou <a href="/reservation/">demande sans engagement</a>.</p>
      </aside>
    </div>
  </section>

  <div class="mobile-bar" data-mobile-bar>
    <div><small>Total</small><strong data-sum-total-mobile>—</strong></div>
    <button type="button" class="btn btn--sm" data-mobile-next>Continuer</button>
  </div>

  <script type="application/json" id="checkout-data" set:html={JSON.stringify(payload)} />
</Base>

<script>
  type Formula = { label: string; price: number };
  type Data = {
    pricing: Record<string, Record<string, Formula[]>>;
    carInfo: Record<string, { name: string; power: number; image: string; category: string }>;
    circuitInfo: Record<string, { name: string; city: string; dept: string; region: string }>;
    regionOrder: string[];
    boxes: { name: string; price: number; text: string }[];
    courier: number;
  };
  const data: Data = JSON.parse(document.getElementById('checkout-data')!.textContent!);
  const form = document.getElementById('checkout') as HTMLFormElement;
  const $ = <T extends Element = HTMLElement>(s: string) => form.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string) => Array.from(form.querySelectorAll<T>(s));
  const euro = (n: number) =>
    n.toLocaleString('fr-FR', { minimumFractionDigits: n % 1 ? 2 : 0, maximumFractionDigits: 2 }) + ' €';

  const carSel = $<HTMLSelectElement>('select[name="voiture"]');
  const circSel = $<HTMLSelectElement>('select[name="circuit"]');
  const formulasBox = $('[data-formulas]');
  let step = 1;

  const produit = () => $<HTMLInputElement>('input[name="produit"]:checked').value;
  const isGift = () => $<HTMLInputElement>('input[name="cadeau"]').checked;
  const byCourier = () => isGift() && $<HTMLInputElement>('input[name="envoi"]:checked').value === 'courrier';

  function fillCircuits(keep?: string) {
    const avail = Object.keys(data.pricing[carSel.value] ?? {});
    const groups = new Map<string, string[]>();
    avail.forEach((slug) => {
      const r = data.circuitInfo[slug]?.region ?? 'Autres';
      groups.set(r, [...(groups.get(r) ?? []), slug]);
    });
    circSel.innerHTML = '';
    data.regionOrder.filter((r) => groups.has(r)).forEach((r) => {
      const og = document.createElement('optgroup');
      og.label = r;
      groups.get(r)!.forEach((slug) => {
        const c = data.circuitInfo[slug];
        og.append(new Option(`${c.name} (${c.dept})`, slug));
      });
      circSel.append(og);
    });
    if (keep && avail.includes(keep)) circSel.value = keep;
  }

  function fillFormulas(keepIndex = 0) {
    const list = data.pricing[carSel.value]?.[circSel.value] ?? [];
    formulasBox.innerHTML = '';
    list.forEach((f, i) => {
      const label = document.createElement('label');
      label.className = 'choice choice--card formula';
      label.innerHTML = `<input type="radio" name="formule" value="${i}" ${i === Math.min(keepIndex, list.length - 1) ? 'checked' : ''} required />
        <strong></strong><small></small>`;
      label.querySelector('strong')!.textContent = f.label;
      label.querySelector('small')!.textContent = euro(f.price);
      formulasBox.append(label);
    });
  }

  function currentFormulaIndex() {
    return Number(form.querySelector<HTMLInputElement>('input[name="formule"]:checked')?.value ?? 0);
  }

  function order() {
    const p = produit();
    const lines: { label: string; detail?: string; amount: number }[] = [];
    let image = '';
    if (p === 'stage') {
      const car = data.carInfo[carSel.value];
      const circ = data.circuitInfo[circSel.value];
      const f = (data.pricing[carSel.value]?.[circSel.value] ?? [])[currentFormulaIndex()];
      const qty = Math.max(1, Math.min(10, Number($<HTMLInputElement>('input[name="quantite"]').value) || 1));
      image = car?.image ?? '';
      if (f) lines.push({ label: `Stage ${car.name}`, detail: `${f.label} · ${circ.name} (${circ.dept})${qty > 1 ? ` · × ${qty}` : ''}`, amount: f.price * qty });
    } else if (p === 'coffret') {
      const name = $<HTMLInputElement>('input[name="coffret"]:checked').value;
      const b = data.boxes.find((x) => x.name === name)!;
      image = '/images/categories/COFFRETcadeau.webp';
      lines.push({ label: `Coffret ${b.name}`, detail: 'Valable un an sur tous les circuits', amount: b.price });
    } else {
      const amount = Math.max(50, Math.min(2000, Number($<HTMLInputElement>('input[name="montant"]').value) || 0));
      image = '/images/categories/CHEQUEcadeau.webp';
      lines.push({ label: 'Chèque cadeau', detail: 'Utilisable sur tous les stages', amount });
    }
    if (isGift()) {
      const who = $<HTMLInputElement>('input[name="beneficiaire"]').value.trim();
      lines.push({ label: 'Bon cadeau personnalisé', detail: who ? `Pour ${who}` : undefined, amount: 0 });
      if (byCourier()) lines.push({ label: 'Coffret envoyé par courrier', amount: data.courier });
    }
    const total = Math.round(lines.reduce((s, l) => s + l.amount, 0) * 100) / 100;
    return { produit: p, lines, total, image };
  }

  function render() {
    const p = produit();
    $$('[data-for]').forEach((el) => (el.hidden = el.dataset.for !== p));
    $('[data-gift]').hidden = !isGift();
    $('[data-address]').hidden = !byCourier();

    const o = order();
    const img = document.querySelector<HTMLImageElement>('[data-sum-img]')!;
    if (o.image && img.getAttribute('src') !== o.image) img.src = o.image;
    const ul = document.querySelector('[data-sum-lines]')!;
    ul.innerHTML = '';
    o.lines.forEach((l) => {
      const li = document.createElement('li');
      li.innerHTML = '<div><strong></strong><small></small></div><span></span>';
      li.querySelector('strong')!.textContent = l.label;
      li.querySelector('small')!.textContent = l.detail ?? '';
      li.querySelector('span')!.textContent = l.amount ? euro(l.amount) : 'Offert';
      ul.append(li);
    });
    const totalTxt = euro(o.total);
    const three = `ou 3 × ${euro(Math.round((o.total / 3) * 100) / 100)} sans frais`;
    document.querySelector('[data-sum-total]')!.textContent = totalTxt;
    document.querySelector('[data-sum-total-mobile]')!.textContent = totalTxt;
    document.querySelector('[data-sum-three]')!.textContent = three;
    $('[data-pay-amount]').textContent = totalTxt;
    $('[data-three]').textContent = `3 × ${euro(Math.round((o.total / 3) * 100) / 100)}, sans frais`;
  }

  function goTo(n: number) {
    step = n;
    $$('[data-step]').forEach((el) => (el.hidden = Number(el.dataset.step) !== n));
    document.querySelectorAll<HTMLElement>('[data-stepper]').forEach((el) => {
      const s = Number(el.dataset.stepper);
      el.classList.toggle('is-current', s === n);
      el.classList.toggle('is-done', s < n);
    });
    const mobileBtn = document.querySelector<HTMLButtonElement>('[data-mobile-next]')!;
    mobileBtn.textContent = n === 3 ? 'Payer' : 'Continuer';
    document.querySelector('.checkout-top')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function validStep(n: number) {
    const stepEl = $(`[data-step="${n}"]`);
    const fields = Array.from(stepEl.querySelectorAll<HTMLInputElement>('input, select, textarea'));
    const hidden = fields.filter((f) => f.closest('[hidden]'));
    hidden.forEach((f) => (f.disabled = true));
    const ok = fields.every((f) => f.disabled || f.checkValidity());
    if (!ok) fields.find((f) => !f.disabled && !f.checkValidity())?.reportValidity();
    hidden.forEach((f) => (f.disabled = false));
    return ok;
  }

  // Événements
  carSel.addEventListener('change', () => {
    const prev = circSel.value;
    fillCircuits(prev);
    fillFormulas(0);
    render();
  });
  circSel.addEventListener('change', () => {
    fillFormulas(currentFormulaIndex());
    render();
  });
  form.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === 'montant_preset') $<HTMLInputElement>('input[name="montant"]').value = t.value;
    render();
  });
  form.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === 'montant') $$<HTMLInputElement>('input[name="montant_preset"]').forEach((r) => (r.checked = r.value === t.value));
    render();
  });
  $$('[data-next]').forEach((b) => b.addEventListener('click', () => validStep(step) && goTo(step + 1)));
  $$('[data-prev]').forEach((b) => b.addEventListener('click', () => goTo(step - 1)));
  document.querySelector('[data-mobile-next]')!.addEventListener('click', () => {
    if (step < 3) validStep(step) && goTo(step + 1);
    else form.requestSubmit();
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!validStep(3)) return;
    const btn = $<HTMLButtonElement>('[data-pay]');
    btn.disabled = true;
    btn.textContent = 'Paiement en cours…';
    const o = order();
    const record = {
      number: 'DEMO-' + Math.random().toString(36).slice(2, 8).toUpperCase(),
      date: new Date().toISOString(),
      buyer: `${$<HTMLInputElement>('input[name="prenom"]').value} ${$<HTMLInputElement>('input[name="nom"]').value}`.trim(),
      email: $<HTMLInputElement>('input[name="email"]').value,
      payment: $<HTMLInputElement>('input[name="paiement"]:checked').value,
      ...o,
    };
    try {
      sessionStorage.setItem('sr-demo-order', JSON.stringify(record));
    } catch {}
    setTimeout(() => (window.location.href = '/commande/confirmation/'), 1200);
  });

  // Pré-remplissage depuis l’URL : ?voiture=…&circuit=…&cadeau=1&produit=coffret|cheque
  const params = new URLSearchParams(location.search);
  const v = params.get('voiture');
  if (v && data.pricing[v]) carSel.value = v;
  const c = params.get('circuit');
  if (c && !v) {
    // Circuit choisi sans voiture : on prend la première voiture disponible sur ce circuit.
    const first = Object.keys(data.pricing).find((slug) => data.pricing[slug][c]);
    if (first) carSel.value = first;
  }
  fillCircuits(c ?? undefined);
  fillFormulas(0);
  const prod = params.get('produit');
  if (prod === 'coffret' || prod === 'cheque') $<HTMLInputElement>(`input[name="produit"][value="${prod}"]`).checked = true;
  const box = params.get('coffret');
  if (box) $$<HTMLInputElement>('input[name="coffret"]').forEach((r) => (r.checked = r.value === box));
  if (params.get('cadeau')) $<HTMLInputElement>('input[name="cadeau"]').checked = true;
  render();
</script>

<style>
  .checkout-top {
    background: var(--bg);
    color: var(--ink);
    padding-block: 32px 8px;
  }
  .checkout-top h1 {
    color: var(--ink);
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 20px;
  }
  .breadcrumb--dark {
    margin-bottom: 10px;
  }
  .stepper {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    font-weight: 600;
    color: #9a9aa6;
  }
  .stepper li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .stepper span {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid #c9c9cf;
    font-size: 0.85rem;
  }
  .stepper .is-current {
    color: var(--ink);
  }
  .stepper .is-current span {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .stepper .is-done {
    color: var(--muted);
  }
  .stepper .is-done span {
    background: var(--teal-700);
    border-color: var(--teal-700);
    color: #fff;
  }

  .demo-note {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-block: 18px 0;
    padding: 12px 16px !important;
    max-width: calc(var(--container) - 2 * var(--gutter));
    border-radius: var(--radius-sm);
    background: #fff4c2;
    color: #4a3b00;
    font-size: 0.92rem;
  }
  .demo-note p {
    margin: 0;
  }
  .demo-note :global(svg) {
    flex: none;
  }
  .checkout-section {
    padding-top: 24px;
  }

  .checkout {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 32px;
    align-items: start;
  }
  .tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    padding: 6px;
    margin-bottom: 24px;
    border-radius: 12px;
    background: var(--bg-soft);
  }
  .tab {
    cursor: pointer;
  }
  .tab input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
